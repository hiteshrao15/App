PORT=3000
NODE_ENV=development

DATABASE_URL=postgresql://user:password@localhost:5432/bottlebazaar
REDIS_URL=redis://localhost:6379

JWT_SECRET=replace-with-a-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-secret

DEV_MOCK_OTP=true
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:19006
RATE_LIMIT_GLOBAL=500
UPLOAD_DIR=uploads

