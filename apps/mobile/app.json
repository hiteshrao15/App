{
  "expo": {
    "name": "BottleBazaar",
    "slug": "bottlebazaar",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.bottlebazaar.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "BottleBazaar uses your location to discover licensed liquor stores nearby and check state excise rules.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "in.bottlebazaar.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {},
    "extra": {
      "eas": {
        "projectId": "cda60f0c-7dae-4613-9af3-d07114360e67"
      }
    }
  }
}
